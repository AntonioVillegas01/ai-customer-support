{
  "name": "@acs/worker",
  "version": "0.0.1",
  "private": true,
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "scripts": {
    "dev": "node --watch --env-file=../../.env -r ts-node/register/transpile-only src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@acs/application": "workspace:*",
    "@acs/config": "workspace:*",
    "@acs/contracts": "workspace:*",
    "@acs/domain": "workspace:*",
    "@acs/logger": "workspace:*",
    "@acs/persistence": "workspace:*",
    "@acs/testing": "workspace:*",
    "@aws-sdk/client-s3": "^3.940.0",
    "@nestjs/common": "^11.1.9",
    "@nestjs/core": "^11.1.9",
    "@nestjs/platform-express": "^11.1.9",
    "bullmq": "^5.65.1",
    "drizzle-orm": "^0.44.7",
    "franc-min": "^6.2.0",
    "html-to-text": "^9.0.5",
    "ioredis": "^5.8.2",
    "pdf-parse": "^1.1.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sanitize-html": "^2.17.0",
    "zod": "^3.25.76",
    "@acs/ai-providers": "workspace:*"
  },
  "devDependencies": {
    "@acs/eslint-config": "workspace:*",
    "@acs/typescript-config": "workspace:*",
    "@types/express": "^5.0.5",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^22.18.14",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.15.5",
    "@types/sanitize-html": "^2.16.0",
    "eslint": "^9.39.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
