{
  "name": "@acs/widget",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 3002 --strictPort",
    "build": "vite build && vite build --config vite.embed.config.ts",
    "preview": "vite preview --port 3002 --strictPort",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run"
  },
  "devDependencies": {
    "@acs/eslint-config": "workspace:*",
    "@acs/typescript-config": "workspace:*",
    "@types/node": "^22.18.14",
    "eslint": "^9.39.0",
    "typescript": "^5.9.3",
    "vite": "^6.3.6",
    "vitest": "^3.2.4"
  }
}
