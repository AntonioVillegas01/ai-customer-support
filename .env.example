# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
# api | worker | web (informational, set per deployable)
APP_NAME=api

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://acs:acs_local_dev@localhost:5433/acs
# Separate unprivileged role used by the app when RLS is enforced (optional locally)
DATABASE_POOL_MAX=10

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6380

# ── Object storage (S3-compatible) ───────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=acs_minio
S3_SECRET_ACCESS_KEY=acs_minio_local_dev
S3_BUCKET_KNOWLEDGE=acs-knowledge
S3_BUCKET_ATTACHMENTS=acs-attachments
S3_FORCE_PATH_STYLE=true

# ── API ──────────────────────────────────────────────────────────────────────
API_PORT=3001
API_BASE_URL=http://localhost:3001
WEB_BASE_URL=http://localhost:3000
WIDGET_BASE_URL=http://localhost:3002
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002
# 32+ char secrets. Generate: openssl rand -hex 32
SESSION_SECRET=change_me_generate_a_random_64_hex_secret_for_local_dev_only_00
WIDGET_TOKEN_SECRET=change_me_generate_a_random_64_hex_secret_for_local_dev_only_11
API_KEY_PEPPER=change_me_generate_a_random_64_hex_secret_for_local_dev_only_22
REQUEST_BODY_LIMIT_MB=2
WORKER_HEALTH_PORT=3002
KNOWLEDGE_UPLOAD_MAX_BYTES=20971520

# ── AI (OpenRouter) ──────────────────────────────────────────────────────────
# Leave AI_PROVIDER=fake to run fully offline with the deterministic fake adapter.
AI_PROVIDER=fake
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL_GENERATION=openai/gpt-4o-mini
AI_MODEL_CLASSIFICATION=openai/gpt-4o-mini
AI_MODEL_SUMMARIZATION=openai/gpt-4o-mini
AI_MODEL_EMBEDDING=openai/text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1536
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
AI_MONTHLY_BUDGET_USD_DEFAULT=50
AI_MAX_CONCURRENCY=8

# ── Observability ────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
LOG_LEVEL=info

# ── Web (Next.js) ────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
